# Required: Supabase PostgreSQL connection string (use the Supabase Connect dialog / pooler URI)
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:6543/postgres

# Required: server-only random secret (at least 32 characters); never prefix with NEXT_PUBLIC_
APP_SECRET=replace-with-a-long-random-secret

# Supabase Auth (publishable key is safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=https://ossv2-vyn9.vercel.app

# Optional: YouTube Data API v3 (server-only; enables in-app YouTube search)
YOUTUBE_API_KEY=

# Optional: Audius API key (server-only; improves catalog and stream request limits)
AUDIUS_API_KEY=

# Optional: Spotify Authorization Code + PKCE
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=

# Optional: transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: browser push and scheduled notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=

# PostgreSQL connection string. For Supabase, use the project's connection string with SSL enabled.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Required for encrypted Spotify tokens. Use a random secret with at least 32 characters.
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Public application origin (used for OAuth and email links).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Optional transactional email (Resend).
RESEND_API_KEY=
EMAIL_FROM=LIFE OS <onboarding@resend.dev>

# Optional scheduled notifications.
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional Spotify integration.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=
